# Dependencies
node_modules/

# Native projects — regenerated by expo prebuild on the build server
android/
ios/

# Separate web applications
admin-dashboard/
public-reports/

# Git
.git/

# IDE / editor files
.vscode/
.idea/

# Local environment files (EAS injects env vars from the build profile)
.env
.env.local
.env.*.local

# Build output & caches
.expo/
dist/
web-build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Never ignore the dynamic app config — EAS needs it to resolve
# googleServicesFile from the GOOGLE_SERVICES_JSON file variable
!app.config.js